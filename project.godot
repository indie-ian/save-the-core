;   param=value ; assign values to parameters

config_version=5

[application]

config/name="save-the-core"
run/main_scene="uid://j3v25m0kjgvn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cgim73rq43aju"

[autoload]

Global="*uid://clyotcp8ucdye"
Library="*uid://dsqa0n466og6"
